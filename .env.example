# ============================================
# Project Face — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ---- PostgreSQL ----
POSTGRES_USER=projectface
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=projectface
DATABASE_URL=postgresql://projectface:changeme_secure_password@postgres:5432/projectface

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Backend ----
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- OpenAI / AI Skin Analysis ----
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# ---- OpenRouter (fallback AI) ----
OPENROUTER_API_KEY=your-openrouter-api-key

# ---- Weather API (OpenWeatherMap) ----
OPENWEATHER_API_KEY=your-openweather-api-key

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_MONTHLY=price_monthly_id
STRIPE_PRICE_YEARLY=price_yearly_id

# ---- ClinicalTrials.gov ----
# No API key required — uses public v2 API

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ---- Branding ----
VITE_BRAND_NAME=Project Face
VITE_BRAND_PARENT=GlowStarLabs
VITE_HUB_URL=https://rvvel.com
VITE_OFFICIAL_URL=https://audreyevansofficial.com
